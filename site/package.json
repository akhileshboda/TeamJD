{
  "name": "teamjd-site",
  "version": "1.0.0",
  "private": true,
  "description": "Express-powered marketing site for Team JD with server-managed third-party assets.",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --ignore data/ --ignore public/assets/generated/ --ignore dist/ server/app.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "sync-assets": "node server/sync-assets.js",
    "sync-assets:dry-run": "node server/sync-assets.js --dry-run",
    "rebuild-assets": "node server/rebuild-assets.js",
    "rebuild-assets:dry-run": "node server/rebuild-assets.js --dry-run",
    "test": "node --test --test-concurrency=1 server/deploy.test.js server/middleware/*.test.js server/routes/*.test.js server/services/*.test.js server/services/mail/*.test.js",
    "deploy:production": "bash server/deploy-production.sh",
    "deploy:staging": "bash server/deploy-staging.sh"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "public/assets/generated/*"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.7",
    "dropbox": "^10.34.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "node-cron": "^4.5.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}

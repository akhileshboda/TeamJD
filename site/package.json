{
  "name": "teamjd-site",
  "version": "1.0.0",
  "private": true,
  "description": "Express-powered marketing site for Team JD with server-managed third-party assets.",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon --ignore data/ --ignore public/assets/generated/ server/app.js",
    "sync-assets": "node server/sync-assets.js",
    "deploy:pi": "bash server/deploy-pi.sh"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "public/assets/generated/*"
    ]
  },
  "dependencies": {
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.7",
    "dropbox": "^10.34.0",
    "express-session": "^1.18.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}

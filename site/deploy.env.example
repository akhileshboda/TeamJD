# Copy to deploy.env (git-ignored) and fill in the real values.
# deploy.sh reads this file; variables already set in your shell win.
# Values: no spaces, no quotes needed.

DEPLOY_USER=deploy
DEPLOY_HOST=your-ssh-host-alias

TEAMJD_PRODUCTION_PATH=/srv/teamjd
TEAMJD_STAGING_PATH=/srv/teamjd-staging

# Must match the PM2 process names already running on the server.
TEAMJD_PRODUCTION_PM2_NAME=teamjd-production
TEAMJD_STAGING_PM2_NAME=teamjd-staging
# Optional: an old staging process name to remove on deploy.
# TEAMJD_STAGING_LEGACY_PM2_NAME=

TEAMJD_PRODUCTION_PORT=3000
TEAMJD_STAGING_PORT=3001
